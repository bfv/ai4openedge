        title=".APL test"
        vendor="bfv.io"
        version="1.0.0-1"
        vendorid="io.bfv"
        type="apl"
        signaturePolicy="required"
        validationPolicy="fail">
      
      <manifest>
        <attribute name="app-version" value="1.0"/>
