<project name="buildvars">

  <target name="initvars" unless="vars_initialized">
     
    <property name="srcdir" location="./src" />
    <property name="rootdir" location="." />
    <property name="builddir" location="${rootdir}/build" />
    <property name="tmpdir" location="${builddir}/tmp" />
    <property name="dbsdir" location="${builddir}/db" />
    <property name="dfdir" location="./db/schema" />
    <property name="artifactdir" location="${rootdir}/artifacts" />
    <property name="cicdfilesdir" location="${rootdir}/cicd" />
    <property name="DLC" value="${env.DLC}" />

    <ProgressVersion dlcHome="${DLC}" majorVersion="dlcMajor" minorVersion="dlcMinor" shortVersion="dlcVersion" />

    <echo level="info" message="rootdir:          ${rootdir}" />
    <echo level="info" message="srcdir:           ${srcdir}" />
    <echo level="info" message="builddir:         ${builddir}" />
    <echo level="info" message="tmpdir:           ${tmpdir}" />
    <echo level="info" message="dbsdir:           ${dbsdir}" />
    <echo level="info" message="dfdir:            ${dfdir}" />
    <echo level="info" message="artifactdir:      ${artifactdir}" />
    <echo level="info" message="cicdfilesdir:     ${cicdfilesdir}" />
    <echo level="info" message="executeUnittests: ${executeUnittests}" />
    <echo level="info" message="DLC:              ${DLC}" />
    <echo level="info" message="dlcVersion:       ${dlcVersion}" />

    <ProgressVersion dlcHome="${env.DLC}" shortVersion="openedgeVersion"/>

    <property name="vars_initialized" value="true" />
  </target>

</project>