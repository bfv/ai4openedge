# OpenEdge container images available to Docker on the host.
DEVCONTAINER_IMAGE=your-registry/openedge-devcontainer:12.8
DB_IMAGE=your-registry/openedge-database:12.8
PAS_IMAGE=your-registry/openedge-pas:12.8

# Absolute host path to the OpenEdge license configuration.
PROGRESS_CFG=/absolute/path/to/progress.cfg

# Optional. Defaults to 8810 when unset or empty.
# PAS_PORT=8810