#!/usr/bin/env bash

set -euo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly CONFIG_PATH="$SCRIPT_DIR/dbconfig.json"

usage() {
    cat <<'EOF'
Gebruik: ./dbconfig <create|update|reset> <database>
        ./dbconfig help
EOF
}

load_database() {
    local database_name="$1"

    if [[ ! -f "$CONFIG_PATH" ]]; then
        printf 'Configuratiebestand niet gevonden: %s\n' "$CONFIG_PATH" >&2
        return 1
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        printf 'python3 is vereist om %s te lezen.\n' "$CONFIG_PATH" >&2
        return 1
    fi

    python3 - "$CONFIG_PATH" "$database_name" <<'PYTHON'
import json
import sys

config_path, database_name = sys.argv[1:]

try:
    with open(config_path, encoding="utf-8") as config_file:
        config = json.load(config_file)
except json.JSONDecodeError as error:
    print(f"Ongeldige JSON in {config_path}: {error}", file=sys.stderr)
    sys.exit(1)

if database_name not in config.get("databases", {}):
    print(f"Onbekende database '{database_name}'.", file=sys.stderr)
    sys.exit(1)
PYTHON
}

command_name="${1:-help}"
database_name="${2:-}"

case "$command_name" in
    help)
        usage
        ;;
    create|update|reset)
        if [[ -z "$database_name" ]]; then
            usage >&2
            printf 'Geef een databasenaam op.\n' >&2
            exit 1
        fi

        load_database "$database_name"
        printf '%s nog niet geïmplementeerd voor database %q.\n' "$command_name" "$database_name"
        ;;
    *)
        usage >&2
        printf 'Onbekend commando: %s\n' "$command_name" >&2
        exit 1
        ;;
esac
